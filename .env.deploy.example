POSTGRES_DB=ghflusao
POSTGRES_USER=ghflusao
POSTGRES_PASSWORD=troque_a_senha_do_postgres
POSTGRES_SCHEMA=public
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
# Gere outro antes de subir producao; este placeholder e bloqueado pelo backend em prod.
JWT_SECRET=troque_o_jwt_secret_base64
JWT_EXPIRATION=86400000
CORS_ORIGINS=http://localhost,http://127.0.0.1,https://seu-dominio.com.br
SWAGGER_ENABLED=false
BOOTSTRAP_DEMO_ADMINS=false

# Producao limpa: prod
# Demo com 30 registros e login funnyValentine/1234: dev,postgres-demo
SPRING_PROFILES_ACTIVE=prod

DB_POOL_MAX=8
DB_POOL_MIN_IDLE=1
FRONTEND_PORT=80
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8080
VITE_API_URL=/api
